# Local dev: point at your local api-server's LAN IP (not localhost — Expo Go
# on a physical device can't resolve localhost back to your dev machine).
EXPO_PUBLIC_API_BASE_URL=https://www.royalmidnight.com/api
# Override with a public staging API URL when one is available.

# Set after `eas init` links this project to your Expo account.
EAS_PROJECT_ID=
