{
  "name": "@royal-midnight/driver-app-v2",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/location/locationLifecycle.test.mjs src/auth/loginValidation.test.mjs src/auth/sessionHydration.test.mjs src/api/openPool.test.mjs src/api/requestTimeout.test.mjs src/notifications/notificationRoute.test.mjs src/theme/nativewind-runtime.test.mjs src/theme/driverPresentation.test.mjs src/trip/tripActionPresentation.test.mjs src/domain/driverWorkflow.test.mjs src/domain/driverBooking.test.mjs src/domain/passengerPreferences.test.mjs src/domain/profileMedia.test.mjs src/domain/earnings.test.mjs src/domain/payout.test.mjs src/domain/driverStatus.test.mjs src/domain/routeUrl.test.mjs src/navigation/returnTarget.test.mjs",
    "eas-build-post-install": "node --test src/theme/nativewind-runtime.test.mjs",
    "export": "expo export",
    "build:android:preview": "node scripts/build-android-preview.mjs",
    "build:android:qa": "node scripts/build-android-qa.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.66.8",
    "date-fns": "^3.6.0",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "57.0.2",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "expo-updates": "~57.0.23",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~57.0.12",
    "typescript": "~6.0.3"
  }
}
