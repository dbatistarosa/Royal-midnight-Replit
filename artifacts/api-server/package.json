    "@types/bcrypt": "^6.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "nodemailer": "^9.0.1",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.10.0",
