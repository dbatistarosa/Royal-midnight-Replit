{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "BASE_PATH=/ pnpm --filter @workspace/royal-midnight run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/royal-midnight/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "crons": [
    { "path": "/api/cron/compliance-check", "schedule": "0 0 * * *" },
    { "path": "/api/cron/weekly-payouts", "schedule": "0 8 * * 1" },
    { "path": "/api/cron/review-requests", "schedule": "0 14 * * *" }
  ]
}
