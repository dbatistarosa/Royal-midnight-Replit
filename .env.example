# ─────────────────────────────────────────────────────────────
# Royal Midnight — Environment Variables Reference
# Copy this file to .env for local development (never commit .env)
# In Vercel: set these under Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=8080                          # only used by local dev (`pnpm start`) — Vercel's serverless runtime ignores this

# ── Public URL (used in emails, Stripe webhook auto-registration) ──
APP_URL=https://royalmidnight.com

# ── Database ─────────────────────────────────────────────────
# Supabase Postgres connection string (Connect → Transaction pooler on the Supabase dashboard).
DATABASE_URL=
# Supabase's CA certificate, from Settings → Database → SSL Configuration.
# Only needed if the DB connection fails with SELF_SIGNED_CERT_IN_CHAIN — the
# pool verifies against public roots plus this value (CN-010). \n escapes are OK.
SUPABASE_CA_CERT=
# Shared secret gating the check-reservation-status Edge Function (CN-008).
# Set on the Supabase side with: supabase secrets set FUNCTION_INVOKE_SECRET=...
FUNCTION_INVOKE_SECRET=change-me-to-a-random-64-char-hex-string

# ── Auth / Session ───────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-32-char-string

# Shared secret for the /api/cron/* endpoints. REQUIRED in every deployed
# environment — without it the cron routes refuse to run (503). Vercel Cron
# sends it automatically as "Authorization: Bearer $CRON_SECRET" once set.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-64-char-hex-string

# AES-256-GCM key for encrypting driver payout bank details at rest.
# Without it those fields are stored in PLAINTEXT. Generate with:
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# ── Admin seed ───────────────────────────────────────────────
# Password for the auto-seeded admin@royalmidnight.com account on first boot
ADMIN_SEED_PASSWORD=change-me-in-production
ADMIN_EMAIL=your@email.com

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://royalmidnight.com,https://www.royalmidnight.com

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...          # sk_test_... for staging
STRIPE_WEBHOOK_SECRET=whsec_...        # auto-registered on boot, but recommended to set explicitly

# ── Mapbox (routes, geocoding, autocomplete) ──────────────────
VITE_MAPBOX_TOKEN=pk.eyJ1...           # embedded in the frontend build — must be set at BUILD time
MAPBOX_ACCESS_TOKEN=pk.eyJ1...         # server-side: Directions + Geocoding APIs

# ── Google (object storage only — Maps was migrated to Mapbox above) ──
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
# Paste your service account JSON as a single-line string (use jq -c . < key.json):
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# ── Email ────────────────────────────────────────────────────
# All verification codes and trip notifications go through Resend for now —
# SMS/WhatsApp (Sent.dm, below) is built but intentionally left dormant.
SMTP_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_...                  # if using Resend
# OR SMTP credentials if using Nodemailer directly:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass

# ── SMS / WhatsApp (Sent.dm via Supabase Edge Function — DORMANT) ─────
# Built and saved for later; not currently wired into any active notification.
# The Express app calls the `send-message-via-sent` Supabase Edge Function;
# SENT_DM_API_KEY itself is set as a Supabase Edge Function secret, not here.
SUPABASE_URL=https://qpqmefenkleyzwnlleih.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── AWS S3 (file uploads via Uppy) ───────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=your-bucket-name

# ── Redis (rate limiting store + read-through cache — optional) ──
# Without these, rate limits fall back to per-instance memory (documented
# limitation: real limit = configured limit x live Vercel instances) and
# cached reads (pricing, vehicle catalog, public settings, address
# autocomplete) hit the database/Mapbox on every request instead of Redis.
# Nothing breaks either way — this only affects latency, cost, and how exact
# the rate limits are.
#
# Easiest path: Vercel dashboard -> Storage -> Create Database -> Upstash for
# Redis -> Connect to this project. That sets KV_REST_API_URL/TOKEN for you
# automatically (no code change needed). A standalone Upstash database
# (console.upstash.com) works the same way via the *_REST_* names below.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=                (used if the KV_* pair above is unset)
# UPSTASH_REDIS_REST_TOKEN=

# ── Error monitoring (Sentry — optional, no-ops if unset) ────
SENTRY_DSN=https://...@o0.ingest.sentry.io/0          # backend (api-server)
VITE_SENTRY_DSN=https://...@o0.ingest.sentry.io/0     # frontend — must be set at BUILD time

# ── Staging / Preview deployments ─────────────────────────────
# Vercel auto-deploys a Preview for every non-production branch/PR — no
# vercel.json change is needed for that. What needs to be set, in the Vercel
# dashboard (Project → Settings → Environment Variables), is a DIFFERENT
# value scoped to "Preview" (vs "Production") for each of:
#   DATABASE_URL              -> point at a Supabase staging branch/project, not prod
#   STRIPE_SECRET_KEY          -> sk_test_... (never a live key on a preview deploy)
#   STRIPE_WEBHOOK_SECRET       -> the test-mode webhook's secret
#   ALLOWED_ORIGINS             -> can stay as-is; preview URLs are handled in
#                                  code via VERCEL_ENV, see app.ts's CORS check
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY -> the staging project/branch's values
# Everything else (Mapbox token, Resend key, etc.) is safe to share across
# Production and Preview, including KV_REST_API_URL/TOKEN — rate-limit keys
# and cached reads are namespaced by route, not by environment, and Preview
# traffic is low enough that sharing the bucket with Production is harmless.
# VERCEL_URL and VERCEL_ENV are injected automatically by Vercel — don't set
# them yourself.
