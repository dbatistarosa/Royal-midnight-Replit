# ─────────────────────────────────────────────────────────────
# Royal Midnight — Environment Variables Reference
# Copy this file to .env for local development (never commit .env)
# In Railway: set these under your service → Variables tab
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=8080                          # Railway injects this automatically

# ── Public URL (used in emails, Stripe webhook auto-registration) ──
APP_URL=https://your-service.up.railway.app   # change to your custom domain once set

# ── Database ─────────────────────────────────────────────────
# Railway PostgreSQL addon injects DATABASE_URL automatically.
# For local dev, set this manually:
DATABASE_URL=postgresql://user:password@localhost:5432/royal_midnight

# ── Auth / Session ───────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-32-char-string

# ── Admin seed ───────────────────────────────────────────────
# Password for the auto-seeded admin@royalmidnight.com account on first boot
ADMIN_SEED_PASSWORD=change-me-in-production
ADMIN_EMAIL=your@email.com

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (not needed if frontend is served by Express)
ALLOWED_ORIGINS=https://your-service.up.railway.app

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...          # sk_test_... for staging
STRIPE_WEBHOOK_SECRET=whsec_...        # auto-registered on boot, but recommended to set explicitly

# ── Google ───────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=AIza...       # embedded in the frontend build — must be set at BUILD time
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
# Paste your service account JSON as a single-line string (use jq -c . < key.json):
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# ── Email ────────────────────────────────────────────────────
SMTP_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_...                  # if using Resend
# OR SMTP credentials if using Nodemailer directly:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass

# ── Twilio (SMS) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# ── AWS S3 (file uploads via Uppy) ───────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=your-bucket-name
